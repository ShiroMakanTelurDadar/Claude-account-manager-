{
  "manifest_version": 2,
  "name": "limitwatch",
  "version": "1.8",
  "browser_specific_settings": {
    "gecko": {
      "id": "limitwatch@app.local"
    }
  },
  "permissions": [
    "nativeMessaging",
    "geckoViewAddons",
    "https://claude.ai/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
