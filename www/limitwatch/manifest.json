{
  "manifest_version": 2,
  "name": "limitwatch",
  "version": "1.1",
  "browser_specific_settings": {
    "gecko": { "id": "limitwatch@app.local" }
  },
  "permissions": ["nativeMessaging", "geckoViewAddons"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
